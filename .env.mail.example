# SMTP settings for HomeBid password-change verification emails
# Configure these in your local Apache/PHP environment; do not commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
SMTP_FROM_NAME=HomeBid
APP_BASE_URL=http://localhost/susi
